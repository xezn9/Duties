    <string name="create_s0_title">سوّي قناتك بخطوات بسيطة</string>
    <string name="create_s0_body">القناة تحتاج ثلاث أشياء أساسية، وإعدادين اختياريين تگدر تضيفهم هسه أو بعدين. اسحب أو اضغط التالي ونمشي خطوة خطوة.</string>

    <string name="create_s1_title">صورة القناة</string>
    <string name="create_s1_body">هاي أول شي يشوفه الناس من قناتك، فاختار صورة واضحة تعبّر عن محتواها.</string>
    <string name="create_s1_t1">استخدم صورة واضحة وبجودة زينة</string>
    <string name="create_s1_t2">الصورة تظهر بشكل دائري، فخلي الموضوع بنص الصورة</string>
    <string name="create_s1_t3">تگدر تغيّرها بأي وقت بعدين</string>

    <string name="create_s2_title">اسم القناة</string>
    <string name="create_s2_body">الاسم هو الي يدوّر عليه الناس، خليه قصير وسهل ويدل على محتوى القناة.</string>
    <string name="create_s2_t1">اختار اسم واضح وسهل التذكر</string>
    <string name="create_s2_t2">تجنّب الاسماء الطويلة والرموز الكثيرة</string>
    <string name="create_s2_t3">تگدر تغيّره بأي وقت بعدين</string>

    <string name="create_s3_title">يوزر القناة</string>
    <string name="create_s3_body">اليوزر هو العنوان الخاص بقناتك، وبيه يلگونها الناس ويدخلون عليها مباشرة.</string>
    <string name="create_s3_t1">حروف انكليزية وارقام وشرطة سفلية _ فقط</string>
    <string name="create_s3_t2">لازم يكون 3 احرف على الاقل</string>
    <string name="create_s3_t3">اليوزر ما يتكرر، إذا مأخوذ اختار غيره</string>

    <string name="create_s4_title">نبذة عن القناة</string>
    <string name="create_s4_body">سطرين تعرّف بيهم الناس على قناتك. هاي الخطوة اختيارية وتگدر تتخطاها.</string>
    <string name="create_s4_t1">اشرح شنو راح تنشر بالقناة</string>
    <string name="create_s4_t2">خليها قصيرة ومباشرة</string>

    <string name="create_s5_title">ادعُ الأعضاء</string>
    <string name="create_s5_body">شارك رابط الدعوة حتى ينضم الناس لقناتك بضغطة وحدة. هاي الخطوة اختيارية وتگدر تسويها بعدين.</string>
    <string name="create_s5_t1">شارك الرابط بالمجموعات والرسائل الخاصة</string>
    <string name="create_s5_t2">تگدر تدعو أعضاء بعد انشاء القناة بأي وقت</string>

