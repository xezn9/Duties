rules_version = '2';

// Duties - Firestore rules
// users/{uid}        : the profile (name, username, bio, small photo) - only the owner can write it
// usernames/{name}   : makes every @username unique (document id = lowercase username)
// channels/{id}      : a channel (owner and members can read it; the owner can delete it; a member can leave it)
//                      isPublic (true = public, false = private) is chosen when the channel is created; channels made
//                      before this field existed have none and count as public.
//                      Anybody signed in can add himself to "members" of a PUBLIC channel (Join button);
//                      a private channel is by invitation only
// channelUsernames/{name} : makes every channel @username unique
// channels.admins     : list of uids (supervisors), written only by the owner. Only the owner and the supervisors can
//                      write messages (enforced in the Realtime Database).
// channels.adminPerms : map  uid -> list of what that supervisor may do: "ban", "kick", "edit". Written only by the owner
//                      (he decides, supervisor by supervisor). A supervisor without an entry can do nothing but write.
//                        ban  = ban / unban members (a banned person is out of "members" and can not come back: neither the
//                               Join button nor an invitation works until the ban is lifted)
//                        kick = remove an ordinary member (he can join again if the channel is public)
//                        edit = change the channel information (name, @username, bio, photo)
//                      A supervisor can never act on the owner or on another supervisor.
// channels.banned     : list of uids that are banned from the channel (written by the owner or by a supervisor with "ban")
// channels.restricted : OLD field of the removed "restrict" feature. Still allowed so old channels stay valid; not used.
// invites/{channelId}_{uid} : an invitation to a channel (pending / accepted / declined)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // name: 1..24 chars | username: 3..24 chars (a-z A-Z 0-9 _ .) | bio: 0..150 chars
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'username', 'bio', 'photo', 'updatedAt'])
        && d.name is string
        && d.name.size() >= 1 && d.name.size() <= 24
        && d.username is string
        && d.username.size() >= 3 && d.username.size() <= 24
        && d.username.matches('^[A-Za-z0-9_.]+$')
        && d.bio is string
        && d.bio.size() <= 150
        && (!('photo' in d.keys()) || (d.photo is string && d.photo.size() <= 60000));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /usernames/{name} {
      allow read: if signedIn();
      // can only be taken if nobody has it yet
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(name))
        && name == name.lower()
        && name.size() >= 3 && name.size() <= 24
        && name.matches('^[a-z0-9_.]+$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // name: 1..24 | username: 3..24 | bio: 0..150 | photo: small JPEG as base64 text (optional)
    // (the part of a channel that the owner AND a supervisor with the "edit" permission may change)
    function validChannelInfo(d) {
      return d.name is string
        && d.name.size() >= 1 && d.name.size() <= 24
        && d.username is string
        && d.username.size() >= 3 && d.username.size() <= 24
        && d.username.matches('^[A-Za-z0-9_.]+$')
        && d.bio is string
        && d.bio.size() <= 150
        && (!('photo' in d.keys()) || (d.photo is string && d.photo.size() <= 200000));
    }

    // members: uids | isPublic: true / false (optional so the old channels without it stay valid)
    // admins: uids | adminPerms: map uid -> list | banned: uids
    function validChannel(d) {
      return d.keys().hasOnly(['name', 'username', 'bio', 'ownerUid', 'members', 'photo', 'isPublic', 'createdAt',
                               'admins', 'adminPerms', 'banned', 'restricted'])
        && validChannelInfo(d)
        && d.ownerUid == request.auth.uid
        && (!('isPublic' in d.keys()) || d.isPublic is bool)
        && (!('admins' in d.keys()) || d.admins is list)
        && (!('adminPerms' in d.keys()) || d.adminPerms is map)
        && (!('banned' in d.keys()) || d.banned is list)
        && (!('restricted' in d.keys()) || d.restricted is list);
    }

    // c = the channel data. True when the signed-in account is a supervisor of it (and still inside) that was given [perm]
    function adminHas(c, perm) {
      return request.auth.uid in c.get('admins', [])
        && request.auth.uid in c.get('members', [])
        && 'adminPerms' in c.keys()
        && request.auth.uid in c.adminPerms
        && perm in c.adminPerms[request.auth.uid];
    }

    // the owner, or a supervisor with the "edit" permission
    function canEditInfo(c) {
      return c.ownerUid == request.auth.uid || adminHas(c, 'edit');
    }

    // b = before, a = after.
    // "kick": exactly one person leaves "members", nobody is added, and he is neither the owner nor a supervisor
    function kicksOrdinaryMember(b, a) {
      return b.members.removeAll(a.members).size() == 1
        && a.members.removeAll(b.members).size() == 0
        && !b.members.removeAll(a.members).hasAny(b.get('admins', []).concat([b.ownerUid]));
    }

    // "ban": exactly one uid is added to "banned" (not the owner, not a supervisor), nobody else is banned or unbanned,
    // nobody is added to "members", at most that one person leaves it, and nobody is both inside and banned
    function bansOrdinaryMember(b, a) {
      return a.banned.removeAll(b.get('banned', [])).size() == 1
        && b.get('banned', []).removeAll(a.banned).size() == 0
        && !a.banned.removeAll(b.get('banned', [])).hasAny(b.get('admins', []).concat([b.ownerUid]))
        && a.members.removeAll(b.members).size() == 0
        && b.members.removeAll(a.members).size() <= 1
        && !a.members.hasAny(a.banned);
    }

    // lifting a ban: exactly one uid leaves "banned"
    function unbansOne(b, a) {
      return b.get('banned', []).removeAll(a.get('banned', [])).size() == 1
        && a.get('banned', []).removeAll(b.get('banned', [])).size() == 0;
    }

    // every signed-in account can find and read a channel (the Home search needs it); the chat messages themselves
    // stay private (they live in the Realtime Database and only the members can read them).
    // A person that was invited can add himself to "members" (only one name, only while his invitation is still pending)
    match /channels/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validChannel(request.resource.data)
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        (resource.data.ownerUid == request.auth.uid
          && validChannel(request.resource.data))
        // anybody joins a PUBLIC channel (the Join button of the Home search): only his own uid is added,
        // everybody that was inside stays (old channels without "isPublic" count as public)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && resource.data.get('isPublic', true) == true
          && !(request.auth.uid in resource.data.get('banned', []))          // a banned person can not join
          && request.auth.uid in request.resource.data.members
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && !(request.auth.uid in resource.data.get('banned', []))          // a banned person can not accept an invitation
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && get(/databases/$(database)/documents/invites/$(id + '_' + request.auth.uid)).data.status == 'pending')
        // a member leaves: only his own name goes out of "members"
        || (resource.data.ownerUid != request.auth.uid
          && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1)
        // the owner leaves while other people are inside: the channel goes to one of the members
        || (resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'members'])
          && request.resource.data.ownerUid != request.auth.uid
          && request.resource.data.ownerUid in request.resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1)
        // a supervisor with the "edit" permission: only the channel information (the owner can not be changed this way)
        || (adminHas(resource.data, 'edit')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'username', 'bio', 'photo'])
          && validChannelInfo(request.resource.data))
        // a supervisor with the "kick" permission: removes one ordinary member
        || (adminHas(resource.data, 'kick')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && kicksOrdinaryMember(resource.data, request.resource.data))
        // a supervisor with the "ban" permission: bans one ordinary member (he goes out of "members" at the same time) ...
        || (adminHas(resource.data, 'ban')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'banned'])
          && bansOrdinaryMember(resource.data, request.resource.data))
        // ... or lifts one ban
        || (adminHas(resource.data, 'ban')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned'])
          && unbansOne(resource.data, request.resource.data))
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // invites/{channelId}_{toUid}: only the sender and the receiver can read it; only the receiver can answer it
    function validInvite(d) {
      return d.keys().hasOnly(['channelId', 'channelName', 'channelUsername', 'channelPhoto',
                               'fromUid', 'fromName', 'fromUsername', 'toUid', 'status', 'createdAt'])
        && d.channelId is string && d.channelName is string && d.channelName.size() <= 24
        && d.channelUsername is string && d.channelUsername.size() <= 24
        && d.fromUid == request.auth.uid
        && d.toUid is string && d.toUid != request.auth.uid
        && d.fromName is string && d.fromName.size() <= 24
        && d.fromUsername is string && d.fromUsername.size() <= 24
        && d.status == 'pending'
        && (!('channelPhoto' in d.keys()) || (d.channelPhoto is string && d.channelPhoto.size() <= 200000));
    }

    match /invites/{id} {
      allow read: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if signedIn()
        && validInvite(request.resource.data)
        && id == request.resource.data.channelId + '_' + request.resource.data.toUid
        && getAfter(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.ownerUid == request.auth.uid
        // a banned person can not be invited
        && !(request.resource.data.toUid in getAfter(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.get('banned', []));
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    match /channelUsernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/channelUsernames/$(name))
        && name == name.lower()
        && name.size() >= 3 && name.size() <= 24
        && name.matches('^[a-z0-9_.]+$')
        && request.resource.data.keys().hasOnly(['uid', 'channelId'])
        && (request.resource.data.uid == request.auth.uid
          // a supervisor with the "edit" permission renames the channel: the new @username still belongs to the OWNER
          || (canEditInfo(get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data)
            && request.resource.data.uid == get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.ownerUid));
      // the old @username is released by its owner, or by a supervisor with the "edit" permission of that channel
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid
          || ('channelId' in resource.data.keys()
            && canEditInfo(get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data)));
      // only when the owner leaves: the @username follows the channel to its new owner
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'channelId'])
        && request.resource.data.channelId == resource.data.channelId
        && request.resource.data.uid != request.auth.uid
        && getAfter(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.ownerUid == request.resource.data.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
