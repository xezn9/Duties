rules_version = '2';

// Duties - Firestore rules
// users/{uid}        : the profile (name, username, bio) - only the owner can write it
// usernames/{name}   : makes every @username unique (document id = lowercase username)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // name: 1..24 chars | username: 3..24 chars (a-z A-Z 0-9 _ .) | bio: 0..150 chars
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'username', 'bio', 'updatedAt'])
        && d.name is string
        && d.name.size() >= 1 && d.name.size() <= 24
        && d.username is string
        && d.username.size() >= 3 && d.username.size() <= 24
        && d.username.matches('^[A-Za-z0-9_.]+$')
        && d.bio is string
        && d.bio.size() <= 150;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /usernames/{name} {
      allow read: if signedIn();
      // can only be taken if nobody has it yet
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(name))
        && name == name.lower()
        && name.size() >= 3 && name.size() <= 24
        && name.matches('^[a-z0-9_.]+$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
