rules_version = '2';

// Duties - Firestore rules
// users/{uid}        : the profile (name, username, bio, small photo) - only the owner can write it
// usernames/{name}   : makes every @username unique (document id = lowercase username)
// channels/{id}      : a channel (owner and members can read it; the owner can delete it; a member can leave it)
//                      isPublic (true = public, false = private) is chosen when the channel is created; channels made
//                      before this field existed have none and count as public
// channelUsernames/{name} : makes every channel @username unique
// invites/{channelId}_{uid} : an invitation to a channel (pending / accepted / declined)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // name: 1..24 chars | username: 3..24 chars (a-z A-Z 0-9 _ .) | bio: 0..150 chars
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'username', 'bio', 'photo', 'updatedAt'])
        && d.name is string
        && d.name.size() >= 1 && d.name.size() <= 24
        && d.username is string
        && d.username.size() >= 3 && d.username.size() <= 24
        && d.username.matches('^[A-Za-z0-9_.]+$')
        && d.bio is string
        && d.bio.size() <= 150
        && (!('photo' in d.keys()) || (d.photo is string && d.photo.size() <= 60000));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /usernames/{name} {
      allow read: if signedIn();
      // can only be taken if nobody has it yet
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(name))
        && name == name.lower()
        && name.size() >= 3 && name.size() <= 24
        && name.matches('^[a-z0-9_.]+$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // name: 1..24 | username: 3..24 | bio: 0..150 | members: uids | photo: small JPEG as base64 text (optional)
    // isPublic: true / false (optional so the old channels without it stay valid)
    function validChannel(d) {
      return d.keys().hasOnly(['name', 'username', 'bio', 'ownerUid', 'members', 'photo', 'isPublic', 'createdAt'])
        && d.name is string
        && d.name.size() >= 1 && d.name.size() <= 24
        && d.username is string
        && d.username.size() >= 3 && d.username.size() <= 24
        && d.username.matches('^[A-Za-z0-9_.]+$')
        && d.bio is string
        && d.bio.size() <= 150
        && d.ownerUid == request.auth.uid
        && (!('isPublic' in d.keys()) || d.isPublic is bool)
        && (!('photo' in d.keys()) || (d.photo is string && d.photo.size() <= 200000));
    }

    // every signed-in account can find and read a channel (the Home search needs it); the chat messages themselves
    // stay private (they live in the Realtime Database and only the members can read them).
    // A person that was invited can add himself to "members" (only one name, only while his invitation is still pending)
    match /channels/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validChannel(request.resource.data)
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        (resource.data.ownerUid == request.auth.uid
          && validChannel(request.resource.data))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && get(/databases/$(database)/documents/invites/$(id + '_' + request.auth.uid)).data.status == 'pending')
        // a member leaves: only his own name goes out of "members"
        || (resource.data.ownerUid != request.auth.uid
          && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1)
        // the owner leaves while other people are inside: the channel goes to one of the members
        || (resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'members'])
          && request.resource.data.ownerUid != request.auth.uid
          && request.resource.data.ownerUid in request.resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1)
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // invites/{channelId}_{toUid}: only the sender and the receiver can read it; only the receiver can answer it
    function validInvite(d) {
      return d.keys().hasOnly(['channelId', 'channelName', 'channelUsername', 'channelPhoto',
                               'fromUid', 'fromName', 'fromUsername', 'toUid', 'status', 'createdAt'])
        && d.channelId is string && d.channelName is string && d.channelName.size() <= 24
        && d.channelUsername is string && d.channelUsername.size() <= 24
        && d.fromUid == request.auth.uid
        && d.toUid is string && d.toUid != request.auth.uid
        && d.fromName is string && d.fromName.size() <= 24
        && d.fromUsername is string && d.fromUsername.size() <= 24
        && d.status == 'pending'
        && (!('channelPhoto' in d.keys()) || (d.channelPhoto is string && d.channelPhoto.size() <= 200000));
    }

    match /invites/{id} {
      allow read: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if signedIn()
        && validInvite(request.resource.data)
        && id == request.resource.data.channelId + '_' + request.resource.data.toUid
        && getAfter(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    match /channelUsernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/channelUsernames/$(name))
        && name == name.lower()
        && name.size() >= 3 && name.size() <= 24
        && name.matches('^[a-z0-9_.]+$')
        && request.resource.data.keys().hasOnly(['uid', 'channelId'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      // only when the owner leaves: the @username follows the channel to its new owner
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'channelId'])
        && request.resource.data.channelId == resource.data.channelId
        && request.resource.data.uid != request.auth.uid
        && getAfter(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.ownerUid == request.resource.data.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
